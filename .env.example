# =============================================================================
# Mavericks Website — environment variables
# =============================================================================
# Copy this file to .env.local for local dev. Never commit real secrets.
# In Vercel, set the same vars under Project Settings → Environment Variables.
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser bundle.

# -----------------------------------------------------------------------------
# Supabase (Step 2+)
# -----------------------------------------------------------------------------
# Project URL and anon key from Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-SIDE ONLY. Never expose to the browser.
# Used by API routes and migration scripts.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe (Step 9+)
# -----------------------------------------------------------------------------
# Use test keys (pk_test_*, sk_test_*, whsec_*) in dev and preview.
# Swap to live keys in Vercel production env at Step 15.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (Phase 2 — transactional email)
# -----------------------------------------------------------------------------
# Not required for Phase 1 cutover. Wire in when transactional email lands.
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL used for Stripe redirect URLs, sitemap, OG images, etc.
# Local: http://localhost:3000. Vercel preview/prod set automatically below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

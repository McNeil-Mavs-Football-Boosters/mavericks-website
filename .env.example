# =============================================================================
# Mavericks Website — environment variables
# =============================================================================
# Copy this file to .env.local for local dev. Never commit real secrets.
# In Vercel, set the same vars under Project Settings → Environment Variables.
# Anything prefixed with NEXT_PUBLIC_ is exposed to the browser bundle.

# -----------------------------------------------------------------------------
# Supabase (Step 2+)
# -----------------------------------------------------------------------------
# Project URL and anon key from Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-SIDE ONLY. Never expose to the browser.
# Used by API routes and migration scripts.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe (Step 9+)
# -----------------------------------------------------------------------------
# Use test keys (pk_test_*, sk_test_*, whsec_*) in dev and preview.
# Swap to live keys in Vercel production env at Step 15.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Resend (Step 4+ — contact form delivery)
# -----------------------------------------------------------------------------
# API key from https://resend.com/api-keys. Server-side only.
RESEND_API_KEY=

# Inbox that receives contact-form submissions. Phase 1: Jeremy's personal Gmail.
# Set the real value in .env.local (and Vercel env vars); do not commit it.
CONTACT_TO_EMAIL=

# From-address used on contact-form sends. The Resend sandbox sender
# (onboarding@resend.dev) works without DNS setup; once Cloudflare nameservers
# go live and Resend verifies mcneilmavericks.org, swap this to
# noreply@mcneilmavericks.org.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public base URL used for Stripe redirect URLs, sitemap, OG images, etc.
# Local: http://localhost:3000. Vercel preview/prod set automatically below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
